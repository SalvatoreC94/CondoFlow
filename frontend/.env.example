# Base URL of the CondoFlow API. Leave empty during local development: Vite's
# dev server proxies /api and /sanctum to the Laravel backend (see
# vite.config.js), so requests stay same-origin and cookies just work.
# In production, point this at your deployed API origin, e.g.
# https://api.condoflow.example.com
VITE_API_URL=
